+def literal_identity(row):
+    payload = {k: v for k, v in row.items() if k != 'id'}
+    return 'sha256:' + hashlib.sha256(('pk/v1/' + row['kind'] + '\n' + literal_canonical(payload)).encode('utf-8')).hexdigest()
