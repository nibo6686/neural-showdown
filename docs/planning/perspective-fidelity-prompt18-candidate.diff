+    def test_non_html_routes_and_generic_parser_do_not_decode_transport(self):
+        source = [r'|switch|p1a: A|Pikachu|25\/100', r'|-damage|p1a: A|20\x2f100', '|win|real']
+        for suffix in ['.log', '.json']:
+            with self.subTest(suffix=suffix):
