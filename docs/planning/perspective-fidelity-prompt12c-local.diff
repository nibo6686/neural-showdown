+LEGACY_POSITIONS = {
+    'observation': (('boundary', 'observation_id'), ('binding', 'input_observation'), ('binding', 'successor_observation')),
+    'belief': (('boundary', 'belief_id'), ('binding', 'input_belief'), ('binding', 'successor_belief')),
