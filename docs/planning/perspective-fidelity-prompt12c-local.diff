+    if (boundary.index === 1 || row.actor_record_id !== null) row.actor_record_id = witness.record_id;
+  }
+  for (const row of audit.tables.binding) {
+    const old = boundaries.get(row.input_index)!.bindings.find((r: Row) => r.owner === row.owner);
+    const fresh = boundaries.get(row.successor_index)!.bindings.find((r: Row) => r.owner === row.owner);
